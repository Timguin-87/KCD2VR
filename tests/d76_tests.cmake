# D76 tests execute the production classifier, native callback/receipt code,
# reload client, participant reader and full animation classification TU.
foreach(suite tracked_step_d76 native_roomscale_d76 roomscale_camera_coordinate_d76 npc_dialogue_d76 roomscale_producer_d76)
 add_executable(${suite}_test ${suite}_test.cpp)
 target_compile_features(${suite}_test PRIVATE cxx_std_20)
 target_include_directories(${suite}_test PRIVATE ../src)
 add_test(NAME ${suite} COMMAND ${suite}_test)
endforeach()
foreach(suite crossbow_entry_intent_d76 riding_ownership_d76)
 add_executable(${suite}_test ${suite}_test.cpp)
 target_compile_features(${suite}_test PRIVATE cxx_std_23)
 target_include_directories(${suite}_test PRIVATE ../src syntax_shims openxr_sdk)
 target_link_libraries(${suite}_test PRIVATE Threads::Threads)
 if(MSVC)
  target_compile_options(${suite}_test PRIVATE /Gy /bigobj)
  target_compile_definitions(${suite}_test PRIVATE _ReturnAddress=HostReturnAddress)
  target_link_options(${suite}_test PRIVATE /OPT:REF)
 else()
  target_compile_options(${suite}_test PRIVATE -fms-extensions -ffunction-sections -fdata-sections)
  target_compile_definitions(${suite}_test PRIVATE _ReturnAddress=HostReturnAddress __fastcall=)
  target_link_options(${suite}_test PRIVATE -Wl,--gc-sections)
 endif()
 add_test(NAME ${suite} COMMAND ${suite}_test)
endforeach()

add_executable(npc_hmd_target_d76_test npc_hmd_target_d76_test.cpp)
target_include_directories(npc_hmd_target_d76_test PRIVATE ../src syntax_shims)
target_compile_features(npc_hmd_target_d76_test PRIVATE cxx_std_20)
add_test(NAME npc_hmd_target_d76 COMMAND npc_hmd_target_d76_test)
