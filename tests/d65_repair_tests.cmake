# Current production helpers and extracted menu owner contributions.
find_package(Python3 COMPONENTS Interpreter REQUIRED)
set(D65_GENERATED_DIR "${CMAKE_CURRENT_BINARY_DIR}/d65_settings")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/../tools/extract_d65_menu_settings.py"
 --out "${D65_GENERATED_DIR}" RESULT_VARIABLE D65_EXTRACT_RESULT)
if(NOT D65_EXTRACT_RESULT EQUAL 0)
 message(FATAL_ERROR "Could not extract current D65 settings owners")
endif()
foreach(suite fist_locomotion_d65 punch_travel_d65 two_hand_bias_d65 transfer_clip_d65 bow_release_lifecycle_d65 menu_settings_d65)
 add_executable(${suite}_test ${suite}_test.cpp)
 target_compile_features(${suite}_test PRIVATE cxx_std_20)
 target_include_directories(${suite}_test PRIVATE ../src ../src/vrik "${D65_GENERATED_DIR}")
 add_test(NAME ${suite} COMMAND ${suite}_test)
endforeach()

if(WIN32)
 add_executable(bow_native_hooks_d65_test bow_native_hooks_d65_test.cpp)
 target_compile_features(bow_native_hooks_d65_test PRIVATE cxx_std_20)
 target_include_directories(bow_native_hooks_d65_test PRIVATE ../src)
 add_test(NAME bow_native_hooks_d65 COMMAND bow_native_hooks_d65_test)
 foreach(suite crossbow_crank_d66c crossbow_native_xr34)
  if(NOT TARGET ${suite}_test)
  add_executable(${suite}_test ${suite}_test.cpp)
  target_compile_features(${suite}_test PRIVATE cxx_std_20)
  target_include_directories(${suite}_test PRIVATE ../src)
  add_test(NAME ${suite} COMMAND ${suite}_test)
  endif()
 endforeach()
endif()
