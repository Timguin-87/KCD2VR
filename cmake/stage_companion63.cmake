cmake_minimum_required(VERSION 3.20)
# Copies only into build staging. Never installs to the game and never deletes.
if(NOT IS_ABSOLUTE "${SOURCE_ROOT}" OR NOT IS_ABSOLUTE "${TARGET_ROOT}" OR SOURCE_ROOT STREQUAL TARGET_ROOT)
  message(FATAL_ERROR "C63 companion staging requires distinct absolute source/output paths")
endif()
set(marker "${SOURCE_ROOT}/Mods/KCD2VR/KCD2VR_UNIFIED63.json")
if(NOT EXISTS "${marker}")
  message(FATAL_ERROR "Missing reviewed C63 unified companion source")
endif()
file(READ "${marker}" inventory)
string(JSON version GET "${inventory}" version)
string(JSON expected GET "${inventory}" pak_sha256)
file(SHA256 "${SOURCE_ROOT}/Mods/KCD2VR/Data/KCD2VR.pak" actual)
if(NOT version EQUAL 63 OR NOT actual STREQUAL expected)
  message(FATAL_ERROR "C63 companion identity/hash mismatch")
endif()
# Validate the source distribution against its inventory BEFORE staging.
# Equality to a corrupted/line-normalized source is not a valid delivery proof.
string(JSON member_count LENGTH "${inventory}" distribution_files)
set(allowed "Data/KCD2VR.pak" "KCD2VR_UNIFIED63.json")
if(member_count LESS 1)
  message(FATAL_ERROR "C63 companion distribution inventory is empty")
endif()
math(EXPR member_last "${member_count}-1")
foreach(index RANGE 0 ${member_last})
  string(JSON relative MEMBER "${inventory}" distribution_files ${index})
  if(relative MATCHES "^/" OR relative MATCHES "(^|/)\\.\\.(/|$)" OR relative MATCHES "\\\\")
    message(FATAL_ERROR "Unsafe C63 distribution inventory path")
  endif()
  list(APPEND allowed "${relative}")
  if(NOT EXISTS "${SOURCE_ROOT}/Mods/KCD2VR/${relative}" OR IS_DIRECTORY "${SOURCE_ROOT}/Mods/KCD2VR/${relative}")
    message(FATAL_ERROR "Missing C63 distribution member: ${relative}")
  endif()
  string(JSON expected_member GET "${inventory}" distribution_files "${relative}")
  file(SHA256 "${SOURCE_ROOT}/Mods/KCD2VR/${relative}" actual_member)
  if(NOT actual_member STREQUAL expected_member)
    message(FATAL_ERROR "C63 source distribution member hash mismatch: ${relative}")
  endif()
endforeach()
file(GLOB_RECURSE package_members LIST_DIRECTORIES FALSE "${SOURCE_ROOT}/Mods/KCD2VR/*")
foreach(member IN LISTS package_members)
  file(RELATIVE_PATH relative "${SOURCE_ROOT}/Mods/KCD2VR" "${member}")
  if(NOT relative IN_LIST allowed)
    message(FATAL_ERROR "Unexpected C63 source distribution member: ${relative}")
  endif()
endforeach()
# Optional content is absent from normal source/builds. Its explicit selection
# receipt controls staging; a leftover directory never opts the user in.
set(selection "${SOURCE_ROOT}/COMPANION_SELECTION.json")
if(NOT EXISTS "${selection}" OR NOT EXISTS "${SOURCE_ROOT}/patch2_companion_inputs.json")
  message(FATAL_ERROR "Missing current companion preparation receipt")
endif()
file(READ "${selection}" selection_json)
string(JSON selection_schema GET "${selection_json}" schema)
string(JSON selection_type TYPE "${selection_json}" optional_gore)
string(JSON with_gore GET "${selection_json}" optional_gore)
if(NOT selection_schema EQUAL 1 OR NOT selection_type STREQUAL "BOOLEAN")
  message(FATAL_ERROR "Invalid companion optional-content selection")
endif()
set(selected_files "COMPANION_SELECTION.json" "patch2_companion_inputs.json")
foreach(member IN LISTS allowed)
  list(APPEND selected_files "Mods/KCD2VR/${member}")
endforeach()
if(with_gore)
set(gore_root "${SOURCE_ROOT}/OptionalGore/Mods/kcd2vr_gore")
set(gore_record "${gore_root}/KCD2VR_GORE_D74.json")
if(NOT EXISTS "${gore_record}" OR NOT EXISTS "${SOURCE_ROOT}/OptionalGore/README_OPTIONAL_GORE.txt")
  message(FATAL_ERROR "Missing D74 separately staged optional gore receipt/instructions")
endif()
file(READ "${gore_record}" gore_inventory)
string(JSON gore_expected GET "${gore_inventory}" pak_sha256)
string(JSON gore_manifest_expected GET "${gore_inventory}" inputs manifest_sha256)
file(SHA256 "${gore_root}/Data/kcd2vr_gore.pak" gore_actual)
file(SHA256 "${gore_root}/mod.manifest" gore_manifest_actual)
if(NOT gore_actual STREQUAL gore_expected OR NOT gore_manifest_actual STREQUAL gore_manifest_expected)
  message(FATAL_ERROR "D74 optional gore source hash mismatch")
endif()
set(gore_allowed "Mods/kcd2vr_gore/Data/kcd2vr_gore.pak" "Mods/kcd2vr_gore/mod.manifest" "Mods/kcd2vr_gore/KCD2VR_GORE_D74.json" "README_OPTIONAL_GORE.txt")
file(GLOB_RECURSE gore_files LIST_DIRECTORIES FALSE "${SOURCE_ROOT}/OptionalGore/*")
foreach(member IN LISTS gore_files)
  file(RELATIVE_PATH relative "${SOURCE_ROOT}/OptionalGore" "${member}")
  if(NOT relative IN_LIST gore_allowed)
    message(FATAL_ERROR "Unexpected D74 optional gore source member: ${relative}")
  endif()
endforeach()

  foreach(member IN LISTS gore_allowed)
    list(APPEND selected_files "OptionalGore/${member}")
  endforeach()
endif()

# Never leave an old differently named PAK beside either content archive.
file(GLOB_RECURSE existing LIST_DIRECTORIES FALSE "${TARGET_ROOT}/*")
foreach(path IN LISTS existing)
  file(RELATIVE_PATH relative "${TARGET_ROOT}" "${path}")
  if(NOT relative IN_LIST selected_files)
    message(FATAL_ERROR "Old companion staging found (${relative}); use a new/clean build directory")
  endif()
endforeach()
# COPY may skip a corrupt same-timestamp target. Compare bytes and verify every
# staged source member instead; timestamps are not delivery authority.
foreach(relative IN LISTS selected_files)
  set(source "${SOURCE_ROOT}/${relative}")
  set(target "${TARGET_ROOT}/${relative}")
  get_filename_component(parent "${target}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${source}" "${target}" RESULT_VARIABLE copied)
  if(NOT copied EQUAL 0 OR NOT EXISTS "${target}")
    message(FATAL_ERROR "C63 staging copy failed: ${relative}")
  endif()
  file(SHA256 "${source}" source_hash)
  file(SHA256 "${target}" target_hash)
  if(NOT source_hash STREQUAL target_hash)
    message(FATAL_ERROR "C63 staged member hash mismatch: ${relative}")
  endif()
endforeach()
message(STATUS "C63 unified companion staged and every member hash verified; installed game and user INI unchanged")
